#!/usr/bin/env bash
# Usage: scripts/build-dist <signing key>. Builds the static Linux binary into dist/ as the tarball
# the GitHub release carries, with SHA256SUMS and a detached signature of it.
set -euo pipefail

target=x86_64-unknown-linux-musl
name=wt-$target

rm -rf dist
mkdir -p "dist/$name"
cargo build --release --locked --target "$target"
cp "target/$target/release/wt" LICENSE README.md "dist/$name/"
tar -C dist -czf "dist/$name.tar.gz" "$name"
rm -r "dist/$name"
(cd dist && sha256sum "$name.tar.gz" > SHA256SUMS)
gpg --yes -u "$1" --armor --detach-sign dist/SHA256SUMS
gpg --verify dist/SHA256SUMS.asc dist/SHA256SUMS
