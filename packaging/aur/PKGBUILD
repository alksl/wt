# Maintainer: Anton Holmgren <me@antonholmgren.com>

pkgname=wt-switcher
pkgver=0.1.0
pkgrel=1
pkgdesc='Keep one git worktree per branch, checked out beside the main checkout'
arch=('x86_64')
url='https://github.com/alksl/wt'
license=('MIT')
depends=('gcc-libs' 'glibc' 'git')
# Not provides=(wt) or conflicts=(wt): that name is extra's Wt C++ toolkit, needed by e.g. lms.
conflicts=('wt-bin' 'wt-go' 'wt-go-bin' 'wt-zig')
makedepends=('cargo' 'git')
checkdepends=('git')
source=("wt::git+$url.git#tag=v$pkgver?signed")
# No checksum for a git source: makepkg verifies the tag's signature against validpgpkeys instead.
sha256sums=('SKIP')
validpgpkeys=('0F7781B7A2AB98DFB83F01B5970E4326B217EC4B') # Anton Holmgren <me@antonholmgren.com>

prepare() {
  cd wt
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd wt
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd wt
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd wt
  install -Dm755 target/release/wt "$pkgdir/usr/bin/wt"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
